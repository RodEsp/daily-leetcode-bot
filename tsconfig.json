{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "lib": [
            "es2024"
        ],
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true
    },
    "include": [
        "src/**/*",
        "types/**/*"
    ],
    "exclude": [
        "node_modules",
    ]
}